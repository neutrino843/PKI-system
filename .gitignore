# PKI演示系统 - Git忽略规则 v2
# 排除所有包含隐私信息的文件：密钥、证书、密码、本地配置、文档等

# ========================
# 文档与评估报告（含内部信息）
# ========================
*.pdf
*.doc
*.docx
测评报告*
评估报告*
测试报告*
*.md
!README.md
!DEPLOY.md
!.gitignore
.trae/

# ========================
# 诊断与内部脚本（含硬编码密码/路径）
# ========================
_diagnose.py
scripts/check_ca_pwd.py
scripts/export_maomao_p12.py
scripts/verify_user_cert.py

# ========================
# 运行时数据（含审计日志、用户数据库）
# ========================
pki_demo/data/

# ========================
# 私钥文件（敏感）
# ========================
pki_demo/keys/

# ========================
# 证书文件（含内部组织信息）
# ========================
pki_demo/certs/
pki_demo/crl/
pki_demo/csr/

# ========================
# 导出产物（含私钥的P12/PEM）
# ========================
pki_demo/export/
export/

# ========================
# Nginx配置与证书
# ========================
nginx/

# ========================
# 加密备份文件
# ========================
pki_demo/backups/

# ========================
# 本地配置文件（含敏感默认值）
# ========================
pki_demo/pki_config.json
pki_demo/setup_env.bat

# ========================
# 测试报告（内部数据）
# ========================
tests/test_https_report.json

# ========================
# 旧版单文件系统
# ========================
mini_pki_demo.py

# ========================
# 临时测试文件
# ========================
test_full_flow.py
server_out.txt
server_err.txt

# ========================
# Python编译缓存
# ========================
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/

